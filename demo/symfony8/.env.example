# Demo environment template. Copy to .env (e.g. cp .env.example .env) and adjust.
# Do not commit .env, .env.dev, or other local .env* files — use this file as reference.

# PORT: Host port mapped to the FrankenPHP (Caddy) HTTP service.
PORT=8022

# FRANKENPHP_MODE: FrankenPHP runtime mode — `classic` (one process per request) or `worker` (long-lived workers).
# Default: worker. Set classic for per-request PHP / easier hot-reload. Recreate with `docker compose up -d` after change (REQ-DEMO-010).
FRANKENPHP_MODE=worker

# PROCESS_TIMEOUT: Shared Nowo Symfony Process wall-clock/idle timeout (seconds) for bundles that spawn
# external tools (LibreOffice, etc.). Default 180. Keep PHP max_execution_time (240) and Caddy write (250)
# above this value — see docs/DEMO-FRANKENPHP.md (REQ-RUNTIME-001). All process-based Nowo demos should
# reuse this same variable name and default.
PROCESS_TIMEOUT=180

###> symfony/framework-bundle ###
# APP_ENV: Symfony environment (dev/test/prod). In demos it is usually `dev`.
APP_ENV=dev
# APP_DEBUG: enable/disable detailed debug output (usually `1` in dev).
APP_DEBUG=1
# APP_SECRET: secret used for signing/tokens. Must be safe (use a local-only value).
APP_SECRET=change_this_secret_key_to_a_random_value
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8022
###< symfony/routing ###

###> symfony/var-dumper ###
VAR_DUMPER_SERVER=127.0.0.1:9912
###< symfony/var-dumper ###
