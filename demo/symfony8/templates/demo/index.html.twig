{% extends 'base.html.twig' %}

{% block title %}WordToPdfBundle demo{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'WordToPdfBundle',
        intro: 'Convert .docx / .doc to PDF via LibreOffice Writer. Works with PHP-FPM and FrankenPHP.',
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Runtime check', kind: 'detail', testid: 'demo-runtime'} %}
        {% block section_body %}
            {% if runtime.ok %}
                <p><span class="nowo-ui-badge nowo-ui-badge--success">OK</span> {{ runtime.message }}</p>
            {% else %}
                <p><span class="nowo-ui-badge nowo-ui-badge--danger">Not ready</span></p>
                <pre class="nowo-ui-code-block nowo-ui-code-block--wrap">{{ runtime.message }}</pre>
            {% endif %}
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Convert upload', intro: 'Upload one or more .docx / .doc files (multipart, max ' ~ maxUploads ~ ') — not PDF. One file returns a PDF; several return a ZIP of PDFs named {name} [converted].pdf.', kind: 'form', testid: 'demo-form'} %}
        {% block section_body %}
            {{ form_start(form, {attr: {id: 'upload-form', class: 'nowo-ui-form'}}) }}
                {{ form_errors(form) }}
                {% for child in form %}
                    {% if not child.rendered and child.vars.name != 'convert' %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(form, {render_rest: false}) }}
        {% endblock %}
        {% block section_footer %}
            <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('demo_sample') }}">Minimal sample.docx → PDF</a>
            <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('demo_download_source', {name: 'sample.docx'}) }}">Download sample source</a>
            <button type="submit" form="upload-form" class="nowo-ui-btn nowo-ui-btn--primary">{{ form.convert.vars.label }}</button>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Stress sample — what this Word throws at the converter', kind: 'content', testid: 'demo-stress'} %}
        {% block section_body %}
            <p class="nowo-ui-muted">
                <code class="nowo-ui-code">stress-styles.docx</code> (<em>DOCX Converter Stress Test</em> v1.0) is a synthetic QA gauntlet for
                <code class="nowo-ui-code">soffice</code> → PDF: images, styles, tables, sections, fields, Unicode and layout edge cases.
                Use it to judge fidelity (not “pretty marketing” output).
                The demo image ships <strong>Liberation / DejaVu / Noto</strong> fonts so glyphs are not tofu boxes.
            </p>

            <div class="nowo-ui-cards">
                <div class="nowo-ui-card">
                    <div class="nowo-ui-card__body">
                        <h3 class="nowo-ui-card__title">Images</h3>
                        <ul>
                            <li>5 embedded assets (JPEG photo + PNGs: icon, chart, transparent gradient)</li>
                            <li>Scaling / proportion and transparency checks</li>
                            <li>Figure captions and legends (§8)</li>
                        </ul>
                    </div>
                </div>
                <div class="nowo-ui-card">
                    <div class="nowo-ui-card__body">
                        <h3 class="nowo-ui-card__title">Tables</h3>
                        <ul>
                            <li>6 tables: quarterly grid, horizontal merge, nested table</li>
                            <li>Wide 10-column ledger on a landscape section</li>
                            <li>Tab-aligned money table (name / dept / amount)</li>
                        </ul>
                    </div>
                </div>
                <div class="nowo-ui-card">
                    <div class="nowo-ui-card__body">
                        <h3 class="nowo-ui-card__title">Styles &amp; typography</h3>
                        <ul>
                            <li>Heading hierarchy + ~169 Word styles in the package</li>
                            <li>Bold, italic, underline, strike, highlight, super/subscript</li>
                            <li>Expanded spacing, small caps, shading, borders</li>
                            <li>Numbered lists + nested bullets; L/C/R/justify alignments</li>
                            <li>Monospace “code” block with sensitive chars (<code class="nowo-ui-code">&lt;&gt;&amp;"'</code>, Windows paths)</li>
                        </ul>
                    </div>
                </div>
                <div class="nowo-ui-card">
                    <div class="nowo-ui-card__body">
                        <h3 class="nowo-ui-card__title">Sections &amp; columns</h3>
                        <ul>
                            <li>4 section properties: portrait ↔ landscape</li>
                            <li><strong>Two-column</strong> flow + explicit column break</li>
                            <li>Long-word wrapping / justification stress text</li>
                        </ul>
                    </div>
                </div>
                <div class="nowo-ui-card">
                    <div class="nowo-ui-card__body">
                        <h3 class="nowo-ui-card__title">Headers, footers &amp; fields</h3>
                        <ul>
                            <li>Running header: <code class="nowo-ui-code">CONVERTER STRESS TEST · DOCX → PDF</code></li>
                            <li>Footer fields <code class="nowo-ui-code">PAGE</code> / <code class="nowo-ui-code">NUMPAGES</code></li>
                            <li>Dynamic <code class="nowo-ui-code">TOC</code> field + cover <code class="nowo-ui-code">DATE</code> field</li>
                            <li>Core metadata (title, subject, keywords)</li>
                        </ul>
                    </div>
                </div>
                <div class="nowo-ui-card">
                    <div class="nowo-ui-card__body">
                        <h3 class="nowo-ui-card__title">Unicode, links &amp; edge cases</h3>
                        <ul>
                            <li>Latin + Greek / Cyrillic / Arabic / Hebrew / CJK + emoji</li>
                            <li>Math / currency symbols and linear “equations”</li>
                            <li>External hyperlink; very long URL and unbroken long words</li>
                            <li>Combining marks, ligatures, mixed dashes</li>
                            <li>Closing validation checklist (images, tables, orientation, columns, fields…)</li>
                        </ul>
                    </div>
                </div>
            </div>

            <p class="nowo-ui-muted">
                FrankenPHP timeout stack (demo): LibreOffice Process <strong>PROCESS_TIMEOUT</strong> (default <strong>180s</strong>)
                → PHP <code class="nowo-ui-code">max_execution_time</code> <strong>240s</strong>
                → Caddy write <strong>250s</strong>; queue wait max <strong>30s</strong>.
                On Process timeout the bundle kills the conversion and orphaned <code class="nowo-ui-code">soffice</code> children.
            </p>
        {% endblock %}
        {% block section_footer %}
            <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('demo_download_source', {name: 'stress-styles.docx'}) }}">Download .docx source</a>
            <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('demo_stress') }}">Convert stress-styles.docx → PDF</a>
        {% endblock %}
    {% endembed %}
{% endblock %}
