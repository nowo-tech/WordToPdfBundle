parameters:
    level: 8
    paths:
        - src
        - tests
    bootstrapFiles:
        - vendor/autoload.php
    # REQ-CS-006: never silence findings here — fix the code instead
    ignoreErrors: []

includes:
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
  # FrankenPHP worker with FRANKENPHP_RESET_KERNEL unset/false (kernel reused; services_resetter may still run).
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker-no-kernel-reset.neon
